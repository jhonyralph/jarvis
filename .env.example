# Central reference generated by scripts/environment-catalog.mjs.
# Nothing here is loaded universally. Copy only the relevant lines to:
#   Hub Windows: %USERPROFILE%\.jarvis\hub.env
#   Hub Linux/macOS: $HOME/.jarvis/hub.env
#   Runner: the matching runner.env; runner Compose: root .env
#   Context Compose: ops/context/.env (prefer scripts/context-setup.mjs)
#   Mobile/Desktop build values: the build/user shell environment
# Every assignment is commented so copying this file cannot enable a secret or unsafe mode.

## Hub e seguranca
# optional; scope=Hub; configure=hub; default=4577
# JARVIS_PORT=4577
# optional; scope=Hub; configure=hub; default=4578
# JARVIS_ADMIN_PORT=4578
# optional; scope=Hub; configure=hub-mobile-build; default=none
# JARVIS_PUBLIC_URL=https://jarvis.example.invalid
# optional; scope=Hub and runner; configure=hub-runner; default=Hub: process cwd; runner: OS home; runner image: /workspace
# JARVIS_CWD=C:/work
# optional; scope=Hub, runner and Core; configure=hub-runner; default=OS home
# JARVIS_HOME=C:/Users/me
# optional; scope=Hub; configure=hub; default=on
# JARVIS_AUTH=on
# optional; scope=Hub; configure=hub; default=0 (no idle expiry)
# JARVIS_DEVICE_TTL_DAYS=0
# optional; scope=Hub; configure=hub; default=5
# JARVIS_AUDIT_MAX_MB=5
# optional; scope=Hub; configure=hub; default=120
# JARVIS_HISTORY_CAP=120
# optional; scope=Hub; configure=hub; default=empty (no allowlist)
# JARVIS_ALLOWED_ORIGINS=https://jarvis.example.invalid
# optional; scope=Hub; configure=hub; default=off
# JARVIS_REQUIRE_TLS=off
# optional; scope=Hub; configure=hub; default=off
# JARVIS_TRUST_PROXY=off
# optional; scope=Hub; configure=hub; default=20
# JARVIS_MAX_PAYLOAD_MB=20
# optional; scope=Hub; configure=hub; default=40
# JARVIS_MAX_CONN_PER_IP=40
# optional; scope=Hub; configure=hub; default=800
# JARVIS_MAX_CONN=800

## Agentes, busca e execucoes
# optional; scope=Hub and runner; configure=hub-runner; default=claude-code
# JARVIS_AGENT=claude-code
# optional; scope=Hub and runner; configure=hub-runner; default=full-access
# JARVIS_AGENT_PERMISSION_MODE=provider-default
# optional; scope=Hub and runner; configure=hub-runner; default=claude-code when registered, otherwise JARVIS_AGENT
# JARVIS_SEARCH_AGENT=claude-code
# optional; scope=Hub and runner; configure=hub-runner; default=haiku
# JARVIS_SEARCH_MODEL=haiku
# optional; scope=Hub and runner; configure=hub-runner; default=JARVIS_SEARCH_MODEL, then haiku
# JARVIS_SUMMARY_MODEL=haiku
# optional; scope=Hub; configure=hub; default=10
# JARVIS_DIGEST_N=10
# optional; scope=Hub; configure=hub; default=0 (disabled)
# JARVIS_SESSION_COST_CAP=0
# optional; scope=Hub and runner; configure=hub-runner; default=4
# JARVIS_TERMINAL_MAX=4
# optional; scope=Hub and runner; configure=hub-runner; default=Windows: powershell.exe; Unix: SHELL or bash
# JARVIS_TERMINAL_SHELL=powershell.exe
# optional; scope=Hub and runner; configure=hub-runner; default=16000
# JARVIS_MANAGED_CONTEXT_CHARS=16000
# optional; scope=Hub and runner; configure=hub-runner; default=600000
# JARVIS_AGENT_CATALOG_FRESH_MS=600000
# optional; scope=Hub and runner; configure=hub-runner; default=3600000
# JARVIS_AGENT_CATALOG_STALE_MS=3600000
# optional; scope=Hub and runner; configure=hub-runner; default=40
# JARVIS_NATIVE_LIMIT=40
# optional; scope=Hub; configure=hub; default=300
# JARVIS_UPDATE_RETRY_SEC=300
# optional; scope=Runner; configure=runner; default=600000
# JARVIS_RUNNER_SELF_UPDATE_MS=600000
# optional; scope=Hub; configure=hub; default=10
# JARVIS_OFFLINE_ALERT_MIN=10
# conditional; scope=Runner and Jarvis MCP server; configure=runner-mcp; default=ws://127.0.0.1:4577
# JARVIS_HUB=ws://127.0.0.1:4577
# conditional; scope=Runner; configure=runner; default=empty; SECRET=yes
# JARVIS_TOKEN=replace-with-generated-runner-token
# optional; scope=Runner; configure=runner; default=none; runner Compose uses Sandbox
# JARVIS_LABEL=Runner
# conditional; scope=Jarvis MCP server; configure=mcp; default=empty; SECRET=yes
# JARVIS_MCP_TOKEN=replace-with-paired-device-token
# optional; scope=Hub and runner; configure=hub-runner; default=enabled
# JARVIS_EXECUTIONS=1
# optional; scope=Hub and runner; configure=hub-runner; default=30
# JARVIS_EXECUTION_RETENTION_DAYS=30
# optional; scope=Hub and runner; configure=hub-runner; default=5000
# JARVIS_EXECUTION_MAX_EVENTS=5000
# optional; scope=Hub and runner; configure=hub-runner; default=6
# JARVIS_EXECUTION_MAX_CONCURRENCY=6
# optional; scope=Hub and runner; configure=hub-runner; default=3
# JARVIS_EXECUTION_MAX_DEPTH=3
# optional; scope=Hub and runner; configure=hub-runner; default=0
# JARVIS_EXECUTION_DEFAULT_WRITE=0
# optional; scope=Hub and runner; configure=hub-runner; default=<JARVIS_HOME or OS home>/.jarvis/worktrees
# JARVIS_EXECUTION_WORKTREE_ROOT=C:/work/jarvis-worktrees
# optional; scope=Hub and runner; configure=hub-runner; default=1.25
# JARVIS_CODEX_PRICE_IN=1.25
# optional; scope=Hub and runner; configure=hub-runner; default=JARVIS_CODEX_PRICE_IN / 10
# JARVIS_CODEX_PRICE_CACHED=0.125
# optional; scope=Hub and runner; configure=hub-runner; default=10
# JARVIS_CODEX_PRICE_OUT=10
# optional; scope=Hub and runner; configure=hub-runner; default=jarvis-ballpark-v1
# JARVIS_CODEX_PRICING_VERSION=jarvis-ballpark-v1
# optional; scope=Hub and runner; configure=hub-runner; default=none; Jarvis catalog default is opus
# ANTHROPIC_MODEL=opus
# optional; scope=Hub and runner; configure=hub-runner; default=none (Copilot auto model)
# COPILOT_MODEL=
# optional; scope=Hub and runner; configure=hub-runner; default=none; then ~/.aider.conf.yml model
# AIDER_MODEL=

## Voz e fala
# optional; scope=Hub voice services; configure=hub; default=python
# JARVIS_PYTHON=python
# optional; scope=Hub voice services; configure=hub; default=installed pt_BR-faber-medium if available, then another installed voice; code seed en_GB-alan-medium
# JARVIS_VOICE=pt_BR-faber-medium
# optional; scope=Hub voice services; configure=hub; default=1.06
# JARVIS_TTS_LENGTH=1.06
# optional; scope=Hub voice services; configure=hub; default=0.32
# JARVIS_TTS_SILENCE=0.32
# optional; scope=Hub voice services; configure=hub; default=0.9
# JARVIS_TTS_NOISEW=0.9
# conditional; scope=Hub voice services; configure=hub; default=none (OpenAI voices unavailable); SECRET=yes
# OPENAI_API_KEY=replace-with-openai-api-key
# optional; scope=Hub voice services; configure=hub; default=gpt-4o-mini-tts
# JARVIS_OPENAI_TTS_MODEL=gpt-4o-mini-tts
# optional; scope=Hub voice services; configure=hub; default=deepdml/faster-whisper-large-v3-turbo-ct2
# JARVIS_STT_MODEL=deepdml/faster-whisper-large-v3-turbo-ct2
# optional; scope=Hub voice services; configure=hub; default=cpu
# JARVIS_STT_DEVICE=cpu
# optional; scope=Hub voice services; configure=hub; default=int8
# JARVIS_STT_COMPUTE=int8
# optional; scope=Hub voice services; configure=hub; default=1
# JARVIS_STT_BEAM=1
# optional; scope=Hub voice services; configure=hub; default=enabled
# JARVIS_STT_CORRECT=1
# optional; scope=Hub voice services; configure=hub; default=all-MiniLM-L6-v2
# JARVIS_EMBED_MODEL=all-MiniLM-L6-v2
# optional; scope=Hub voice services; configure=hub; default=OS home/.jarvis/voiceprints
# JARVIS_VOICEPRINTS=C:/Users/me/.jarvis/voiceprints
# optional; scope=Hub voice services; configure=hub; default=0.75 in Python; Hub leaves it unset unless configured
# JARVIS_VOICE_THRESHOLD=0.75
# optional; scope=Hub voice services; configure=hub; default=off
# JARVIS_VOICE_GATE=0
# optional; scope=Hub voice services; configure=hub; default=enabled
# JARVIS_WAKE=1
# optional; scope=Hub and Python wake listener; configure=hub; default=voice
# JARVIS_WAKE_SESSION=voice
# optional; scope=Hub voice services; configure=hub; default=JARVIS_AGENT
# JARVIS_WAKE_AGENT=claude-code
# optional; scope=Hub voice services; configure=hub; default=JARVIS_CWD
# JARVIS_WAKE_CWD=C:/work
# optional; scope=Hub voice services; configure=hub; default=none
# JARVIS_WAKE_EFFORT=low
# optional; scope=Hub and Python wake listener; configure=hub; default=Hub: none; Python: hey_jarvis
# JARVIS_WAKE_MODEL=
# optional; scope=Hub voice services; configure=hub; default=haiku
# JARVIS_VOICE_FAST_MODEL=haiku
# optional; scope=Hub voice services; configure=hub; default=opus
# JARVIS_VOICE_UPGRADE_MODEL=opus
# optional; scope=Hub voice services; configure=hub; default=on
# JARVIS_VOICE_RELEVANCE=on
# optional; scope=Hub voice services; configure=hub; default=JARVIS_SEARCH_MODEL; ignored if not in adapter catalog
# JARVIS_VOICE_INTENT_MODEL=haiku
# optional; scope=Hub voice services; configure=hub; default=enabled
# JARVIS_ASK=1
# optional; scope=Python wake listener; configure=wake; default=ws://127.0.0.1:4577
# JARVIS_HUB_WS=ws://127.0.0.1:4577
# optional; scope=Python wake listener; configure=wake; default=none
# JARVIS_WAKE_MODEL_FILE=C:/models/jarvis.onnx
# optional; scope=Python wake listener; configure=wake; default=0.5
# JARVIS_WAKE_THRESHOLD=0.5
# optional; scope=Python wake listener; configure=wake; default=pt
# JARVIS_WAKE_LANG=pt
# optional; scope=Python wake listener; configure=wake; default=0
# JARVIS_WAKE_GATE=0

## Contexto pessoal e push
# optional; scope=Hub; configure=hub; default=Mapas Culturais: America/Sao_Paulo; generic feed: UTC
# JARVIS_CONTEXT_TIMEZONE=America/Sao_Paulo
# optional; scope=Hub; configure=hub; default=Configured open event feed
# JARVIS_EVENTS_ATTRIBUTION=My event feed
# optional; scope=Hub; configure=hub; default=jsonld behavior
# JARVIS_EVENTS_FEED_FORMAT=jsonld
# optional; scope=Hub; configure=hub; default=none (source disabled)
# JARVIS_EVENTS_FEED_URL=https://events.example.invalid/feed.json
# optional; scope=Hub; configure=hub; default=none (source disabled)
# JARVIS_MAPAS_CULTURAIS_URL=https://mapas.example.invalid/api/event/find
# optional; scope=Hub; configure=hub; default=none
# JARVIS_NOMINATIM_EMAIL=operator@example.invalid
# optional; scope=Hub; configure=hub; default=none (integrated geocoding disabled)
# JARVIS_NOMINATIM_URL=http://127.0.0.1:8080/
# optional; scope=Hub; configure=hub; default=none (routing disabled)
# JARVIS_VALHALLA_URL=http://127.0.0.1:8002/
# optional; scope=Hub; configure=hub; default=https://overpass-api.de/api/interpreter
# JARVIS_OVERPASS_URL=https://overpass-api.de/api/interpreter
# optional; scope=Hub; configure=hub; default=https://api.open-meteo.com/v1/forecast
# JARVIS_OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
# optional; scope=Hub; configure=hub; default=https://api.openchargemap.io/v3/poi/ when key is set
# JARVIS_OCM_URL=https://api.openchargemap.io/v3/poi/
# conditional; scope=Hub; configure=hub; default=none (OCM source disabled); SECRET=yes
# JARVIS_OCM_API_KEY=replace-with-ocm-api-key
# optional; scope=Hub; configure=hub; default=none (Hub map archive route disabled)
# JARVIS_PMTILES_FILE=./ops/context/runtime/pmtiles/region.pmtiles
# optional; scope=Hub; configure=hub; default=none (network-free fallback style)
# JARVIS_MAP_STYLE_FILE=./ops/context/map/style.json
# optional; scope=Hub; configure=hub; default=enabled for opted-in devices
# JARVIS_PERSONAL_PROACTIVE=1
# optional; scope=Hub; configure=hub; default=5
# JARVIS_PERSONAL_PROACTIVE_INTERVAL_MIN=5
# conditional; scope=Hub; configure=hub; default=none (native push disabled); SECRET=pointer
# JARVIS_FCM_SA=C:/secrets/firebase-service-account.json

## Docker Compose de contexto
# optional; scope=ops/context Compose interpolation; configure=context-compose; default=jarvis-context
# COMPOSE_PROJECT_NAME=jarvis-context
# optional; scope=ops/context Compose interpolation; configure=context-compose; default=empty (no sidecar)
# COMPOSE_PROFILES=
# optional; scope=ops/context Compose interpolation; configure=context-compose; default=127.0.0.1
# CONTEXT_BIND_HOST=127.0.0.1
# optional; scope=ops/context Compose interpolation; configure=context-compose; default=mediagis/nominatim:5.3.2
# CONTEXT_NOMINATIM_IMAGE=mediagis/nominatim:5.3.2
# optional; scope=ops/context Compose interpolation; configure=context-compose; default=full
# CONTEXT_NOMINATIM_IMPORT_STYLE=full
# conditional; scope=ops/context Compose interpolation; configure=context-compose; default=empty; SECRET=yes
# CONTEXT_NOMINATIM_PASSWORD=replace-with-generated-password
# optional; scope=ops/context Compose interpolation; configure=context-compose; default=8080
# CONTEXT_NOMINATIM_PORT=8080
# optional; scope=ops/context Compose interpolation; configure=context-compose; default=1gb
# CONTEXT_NOMINATIM_SHM_SIZE=1gb
# optional; scope=ops/context Compose interpolation; configure=context-compose; default=4
# CONTEXT_NOMINATIM_THREADS=4
# optional; scope=ops/context Compose interpolation; configure=context-compose; default=2
# CONTEXT_NOMINATIM_WORKERS=2
# conditional; scope=ops/context Compose interpolation; configure=context-compose; default=./runtime/imports/region.osm.pbf
# CONTEXT_PBF_FILE=./runtime/imports/region.osm.pbf
# optional; scope=ops/context Compose interpolation; configure=context-compose; default=region.pmtiles
# CONTEXT_PMTILES_ARCHIVE=region.pmtiles
# optional; scope=ops/context Compose interpolation; configure=context-compose; default=http://127.0.0.1:4577
# CONTEXT_PMTILES_CORS=http://127.0.0.1:4577
# conditional; scope=ops/context Compose interpolation; configure=context-compose; default=./runtime/pmtiles
# CONTEXT_PMTILES_DIR=./runtime/pmtiles
# optional; scope=ops/context Compose interpolation; configure=context-compose; default=protomaps/go-pmtiles:v1.31.2
# CONTEXT_PMTILES_IMAGE=protomaps/go-pmtiles:v1.31.2
# optional; scope=ops/context Compose interpolation; configure=context-compose; default=8081
# CONTEXT_PMTILES_PORT=8081
# optional; scope=ops/context Compose interpolation; configure=context-compose; default=http://127.0.0.1:8081
# CONTEXT_PMTILES_PUBLIC_URL=http://127.0.0.1:8081
# conditional; scope=ops/context Compose interpolation; configure=context-compose; default=./runtime/valhalla
# CONTEXT_VALHALLA_DIR=./runtime/valhalla
# optional; scope=ops/context Compose interpolation; configure=context-compose; default=ghcr.io/valhalla/valhalla-scripted:3.8.3
# CONTEXT_VALHALLA_IMAGE=ghcr.io/valhalla/valhalla-scripted:3.8.3
# optional; scope=ops/context Compose interpolation; configure=context-compose; default=8002
# CONTEXT_VALHALLA_PORT=8002
# optional; scope=ops/context Compose interpolation; configure=context-compose; default=2
# CONTEXT_VALHALLA_THREADS=2

## Clientes e build
# optional; scope=Electron desktop and Capacitor build; configure=desktop-mobile; default=Desktop: http://127.0.0.1:4577; mobile: no remote server URL
# JARVIS_APP_HUB_URL=https://jarvis.example.invalid
# optional; scope=Desktop/mobile/tooling; configure=shell; default=none; SDK auto-discovery follows
# ANDROID_HOME=C:/Users/me/AppData/Local/Android/Sdk
# optional; scope=Desktop/mobile/tooling; configure=shell; default=none; checked after ANDROID_HOME
# ANDROID_SDK_ROOT=C:/Users/me/AppData/Local/Android/Sdk
# optional; scope=Desktop/mobile/tooling; configure=shell; default=none; checked after ANDROID_SDK_ROOT
# ANDROID_SDK=C:/Users/me/AppData/Local/Android/Sdk
# optional; scope=Desktop/mobile/tooling; configure=shell; default=Electron installer default
# ELECTRON_MIRROR=https://mirror.example.invalid/electron/

# Dynamic secretRef names are intentionally absent: choose the name in the source
# configuration and define its value only in the Hub process environment.
