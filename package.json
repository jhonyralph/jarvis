{
  "name": "jarvis",
  "private": true,
  "version": "0.10.1",
  "description": "Self-hosted, agent-agnostic, voice-first control plane for coding agents",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json",
    "test": "node --import tsx --test \"packages/*/src/**/*.test.ts\" \"apps/*/src/**/*.test.ts\" \"desktop/src/**/*.test.js\" \"mobile/hub-url-web.test.mjs\"",
    "test:agents": "node --import tsx --test packages/core/src/agent-contract.test.ts packages/core/src/agents.test.ts packages/core/src/native.test.ts packages/core/src/turn.test.ts",
    "test:e2e": "node --import tsx --test apps/hub/src/parity.e2e.test.ts",
    "test:ui:personal": "playwright test --config tests/personal-assistant/playwright.config.ts",
    "test:ui:personal:install": "playwright install chromium",
    "agents:report": "node --import tsx scripts/agent-report.ts",
    "update:verify": "npm run check",
    "check": "npm run typecheck && npm test",
    "hooks:install": "git config core.hooksPath .githooks",
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "scripts:list": "node scripts/run.mjs --list",
    "vendor:context": "node scripts/vendor-context.mjs",
    "context:setup": "node scripts/context-setup.mjs",
    "context:doctor": "node scripts/context-doctor.mjs",
    "context:doctor:offline": "node scripts/context-doctor.mjs --offline",
    "setup": "node scripts/run.mjs setup",
    "doctor": "node scripts/run.mjs doctor",
    "install:hub": "node scripts/run.mjs install-hub",
    "install:runner": "node scripts/run.mjs install-runner",
    "install:desktop": "node scripts/run.mjs install-desktop",
    "build:android": "node scripts/run.mjs build-android",
    "build:android:release": "node scripts/run.mjs build-android-release",
    "build:aab": "node scripts/run.mjs build-aab",
    "build:ios": "node scripts/run.mjs build-ios",
    "build:apple": "node scripts/run.mjs build-apple",
    "start:hub": "node scripts/run.mjs start-hub",
    "start:runner": "node scripts/run.mjs start-runner",
    "restart:hub": "node scripts/run.mjs restart-hub",
    "pack": "node scripts/run.mjs pack",
    "release": "node scripts/run.mjs release",
    "jarvis": "node scripts/run.mjs jarvis"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.5",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.0"
  }
}
