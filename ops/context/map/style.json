{
  "version": 8,
  "name": "Jarvis local context",
  "sources": {
    "local-osm": {
      "type": "vector",
      "url": "pmtiles:///context/maps/region.pmtiles",
      "attribution": "Map data &copy; <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap contributors</a>"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#f2f4f1" }
    },
    {
      "id": "earth",
      "type": "fill",
      "source": "local-osm",
      "source-layer": "earth",
      "paint": { "fill-color": "#e7eadf" }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "local-osm",
      "source-layer": "landuse",
      "paint": { "fill-color": "#d9e6d2", "fill-opacity": 0.55 }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "local-osm",
      "source-layer": "water",
      "paint": { "fill-color": "#a9cfdf" }
    },
    {
      "id": "buildings",
      "type": "fill",
      "source": "local-osm",
      "source-layer": "buildings",
      "minzoom": 13,
      "paint": { "fill-color": "#d7d2ca", "fill-outline-color": "#bbb6af" }
    },
    {
      "id": "roads",
      "type": "line",
      "source": "local-osm",
      "source-layer": "roads",
      "paint": {
        "line-color": "#ffffff",
        "line-width": ["interpolate", ["linear"], ["zoom"], 5, 0.35, 12, 1.4, 17, 4]
      }
    }
  ]
}

