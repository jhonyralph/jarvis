# Copy with `node scripts/context-setup.mjs`; do not put real secrets in this file.
COMPOSE_PROJECT_NAME=jarvis-context
COMPOSE_PROFILES=

# Sidecars are local-only and inactive until a profile is selected.
CONTEXT_BIND_HOST=127.0.0.1
CONTEXT_NOMINATIM_PORT=8080
CONTEXT_VALHALLA_PORT=8002
CONTEXT_PMTILES_PORT=8081

# Exact image tags are mirrored in versions.json. Avoid floating tags.
CONTEXT_NOMINATIM_IMAGE=mediagis/nominatim:5.3.2
CONTEXT_VALHALLA_IMAGE=ghcr.io/valhalla/valhalla-scripted:3.8.3
CONTEXT_PMTILES_IMAGE=protomaps/go-pmtiles:v1.31.2

# setup writes absolute paths to the untracked .env. These placeholders are not downloaded.
CONTEXT_PBF_FILE=./runtime/imports/region.osm.pbf
CONTEXT_VALHALLA_DIR=./runtime/valhalla
CONTEXT_PMTILES_DIR=./runtime/pmtiles
CONTEXT_PMTILES_ARCHIVE=region.pmtiles

# setup generates this value only in the ignored .env. It is intentionally empty here.
CONTEXT_NOMINATIM_PASSWORD=
CONTEXT_NOMINATIM_SHM_SIZE=1gb
CONTEXT_NOMINATIM_IMPORT_STYLE=full
CONTEXT_NOMINATIM_THREADS=4
CONTEXT_NOMINATIM_WORKERS=2
CONTEXT_VALHALLA_THREADS=2
CONTEXT_PMTILES_PUBLIC_URL=http://127.0.0.1:8081
CONTEXT_PMTILES_CORS=http://127.0.0.1:4577

# Hub variables consumed directly by the Context Engine. All integrations are optional.
# JARVIS_NOMINATIM_URL=http://127.0.0.1:8080/
# JARVIS_NOMINATIM_EMAIL=operator@example.invalid
# JARVIS_PERSONAL_PROACTIVE=1
# JARVIS_PERSONAL_PROACTIVE_INTERVAL_MIN=5
# JARVIS_VALHALLA_URL=http://127.0.0.1:8002/
# JARVIS_OVERPASS_URL=https://overpass-api.de/api/interpreter
# JARVIS_OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
# JARVIS_OCM_URL=https://api.openchargemap.io/v3/poi/
# JARVIS_OCM_API_KEY=
# JARVIS_MAPAS_CULTURAIS_URL=
# JARVIS_EVENTS_FEED_URL=
# JARVIS_EVENTS_FEED_FORMAT=jsonld
# JARVIS_EVENTS_ATTRIBUTION=
JARVIS_CONTEXT_TIMEZONE=America/Sao_Paulo
# JARVIS_PMTILES_FILE=./ops/context/runtime/pmtiles/region.pmtiles
# JARVIS_MAP_STYLE_FILE=./ops/context/map/style.json

# JARVIS_HOME is shared with the Hub and relocates its .jarvis/personal state root.
# JARVIS_HOME=

# CalDAV, MCP and Home Assistant secrets are dynamic secretRef values. Choose a name in the UI,
# define that name only in the Hub process environment, and never add its value to this example.
# JARVIS_CALDAV_SECRET=
# JARVIS_MCP_AUTH_TOKEN=
# JARVIS_HOME_ASSISTANT_TOKEN=
