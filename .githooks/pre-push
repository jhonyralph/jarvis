#!/usr/bin/env sh
# Gate de pre-push — roda LOCALMENTE o mesmo que o CI roda, antes de o commit sair da máquina.
#
# Motivo: um push em main dispara release automático (.github/workflows/release.yml). Se o código
# quebra, o release simplesmente não sai e o repo fica com main vermelho até alguém perceber —
# aconteceu: o CI ficou 6 dias vermelho sem ninguém notar.
#
# LIMITE HONESTO: isto roda só NA SUA PLATAFORMA. Falhas específicas de outro SO (as que já nos
# morderam: caminhos "C:/" que só são absolutos no Windows, portas efêmeras reusadas no Linux)
# continuam sendo pegas apenas pelo CI, que roda Ubuntu + Windows. Este gate elimina o caso comum
# (typecheck/teste quebrado), não substitui o CI.
#
# Pular em uma emergência: git push --no-verify

set -e

# NÃO rodar no CI. O release.yml já executa typecheck+testes como STEP explícito ANTES do
# semantic-release; quando o @semantic-release/git faz o push do commit de release, este hook
# re-rodava a suíte INTEIRA (e2e/portas/timing) e um único flake BLOQUEAVA a release ("[pre-push]
# BLOQUEADO: testes falharam") — foi o que travou o corte de versões. GitHub Actions define CI e
# GITHUB_ACTIONS; nesses casos o gate do CI é a fonte da verdade e este hook sai limpo. Localmente
# (push do dev) o gate continua valendo normalmente.
if [ -n "$CI" ] || [ -n "$GITHUB_ACTIONS" ]; then exit 0; fi

# Nada a validar quando o push só apaga refs remotas.
only_deletes=1
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] || only_deletes=0
done
[ "$only_deletes" = "1" ] && exit 0

printf '\n[pre-push] validando antes de enviar (pule com --no-verify)\n'

fail() { printf '\n[pre-push] BLOQUEADO: %s\n\n' "$1" >&2; exit 1; }

printf '  -> typecheck\n'
npm run --silent typecheck || fail 'typecheck falhou'

printf '  -> testes\n'
# A saída da 1ª rodada fica em .git/pre-push-first-run.log (nunca versionado) e uma falha imprime os
# testes que caíram. Antes ela ia para /dev/null: a falha que a 2ª rodada "perdoava" não deixava rastro
# nenhum para investigar — e o aviso logo abaixo diz que os flakes catalogados aqui eram bug de verdade.
first_log="$(git rev-parse --git-dir 2>/dev/null || echo .git)/pre-push-first-run.log"   # set -e: sem o || um rev-parse falho mataria o hook mudo
if ! npm test --silent >"$first_log" 2>&1; then
  printf '\n[pre-push] a primeira rodada falhou — saída completa em %s\n' "$first_log"
  grep -E '^[[:space:]]*not ok' "$first_log" | head -20 | sed 's/^/    /' || true
  # A primeira rodada falhou. Roda de novo MOSTRANDO a saída — o resumo silencioso não ajuda a
  # consertar — e o resultado DELA é que decide.
  #
  # Antes o `fail` vinha SEMPRE, mesmo quando a segunda rodada passava. Resultado observado: um
  # "[pre-push] BLOQUEADO: testes falharam" impresso logo abaixo de um "# fail 0", com o push
  # barrado por ruído. A suíte tem e2e sensível a porta/timing sob carga.
  #
  # NENHUM flake catalogado aqui de propósito — este comentário já catalogou dois, e os DOIS eram
  # bug de verdade. Fica o registro, porque o padrão se repete:
  #
  #   • apps/hub/src/update-handshake.e2e.test.ts foi marcado como "flake de timing". Não era: num
  #     Mac Intel falhava 4 em 4 vezes ISOLADO, porque o Hub abria a porta antes de resolver o
  #     próprio commit. Bug, consertado.
  #   • apps/hub/src/parity.e2e.test.ts ("remote live activity survives a Hub restart...") foi
  #     marcado como contenção de CPU, por raspar o teto de 40 s com a suíte cheia (34-39 s) e
  #     passar isolado. Também não era: a correção acima tinha posto um `await` de ~0,5 s (8 s sob
  #     carga) antes do server.listen, e cada restart de Hub no teste pagava isso. Movido o await
  #     para quem usa o commit, o teste caiu para 23 s e a suíte fechou em 0 falhas.
  #
  # O teste que decide NÃO é "passa isolado?" — os dois passavam. É: a duração mudou junto com uma
  # alteração sua? Então é sua. Compare contra o HEAD limpo (`git stash -u`) antes de culpar a CPU.
  #
  # Uma quebra de verdade falha nas DUAS rodadas e continua barrando — que é o ponto do gate.
  printf '\n[pre-push] repetindo com a saída visível\n\n'
  npm test || fail 'testes falharam nas DUAS rodadas'
  printf '\n[pre-push] a segunda rodada passou — primeira tratada como flake, seguindo\n'
  printf '[pre-push] a falha da 1ª rodada segue em %s — compare contra o HEAD limpo antes de culpar a CPU\n' "$first_log"
fi

# app.js não é coberto pelo tsc e é o arquivo que mais mexemos — um erro de sintaxe aqui derruba a
# UI inteira e só apareceria no navegador.
printf '  -> sintaxe do client (app.js)\n'
node --check apps/hub/web/app.js || fail 'apps/hub/web/app.js tem erro de sintaxe'

printf '[pre-push] ok\n\n'
